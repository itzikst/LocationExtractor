          <Data name="Installation_Type"><value>Deep Well</value></Data>
          <Data name="Region"><value>Mesopotamia</value></Data>
          <Data name="Location_Precision"><value>Tier 4: International Comparative Site (&lt; 100m - 1km)</value></Data>
          <Data name="Dates"><value>-4500 to -3300 BCE</value></Data>
          <Data name="Chapter_Section"><value>2.4.3</value></Data>
          <Data name="Dissertation_Pages"><value>53, 54</value></Data>
