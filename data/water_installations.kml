          <Data name="Location_Precision"><value>Tier 4: International Comparative Site (&lt; 100m - 1km)</value></Data>
          <Data name="Dates"><value>-3300 to -2200 BCE</value></Data>
          <Data name="Chapter_Section"><value>2.5.4</value></Data>
          <Data name="Dissertation_Pages"><value>57</value></Data>
