        <Data name="Installation_Type"><value>Aqueduct Channel</value></Data>
        <Data name="Region"><value>Jordan Valley</value></Data>
        <Data name="Location_Precision"><value>Tier 1: High Precision (Pinpoint Well/Installation &lt; 50m)</value></Data>
